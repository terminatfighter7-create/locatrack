  <div class="modal-overlay" id="modal-admin-login">
    <div class="modal-box">
      <div class="modal-icon"></div>
      <h3>Accès administrateur</h3>
      <p>Cet espace est réservé. Saisissez le code d'accès.</p>
      <input type="password" id="admin-code-input" placeholder="Code d'accès" style="margin-bottom:8px;">
      <div class="error-text" id="admin-error"></div>
