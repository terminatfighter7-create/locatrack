  alertTriangle:'<path d="M12 3 2 21h20L12 3z"/><line x1="12" y1="9" x2="12" y2="14"/><line x1="12" y1="17" x2="12" y2="17.01"/>',
  user:'<circle cx="12" cy="8" r="4"/><path d="M4 20.5c0-4.1 3.8-6.5 8-6.5s8 2.4 8 6.5"/>',
  info:'<circle cx="12" cy="12" r="9"/><line x1="12" y1="11" x2="12" y2="16"/><line x1="12" y1="8" x2="12" y2="8.01"/>',
  lock:'<rect x="5" y="11" width="14" height="9" rx="2.5"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  plus:'<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>',
  x:'<line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/>',
  creditCard:'<rect x="3" y="6" width="18" height="13" rx="2.5"/><line x1="3" y1="10.5" x2="21" y2="10.5"/>',
  key:'<circle cx="7.5" cy="14.5" r="3.5"/><path d="M9.8 12.2 18 4"/><path d="M14 8l3 3"/>',
  edit:'<path d="M4 20h4l10.3-10.3a2 2 0 0 0 0-2.8l-1.2-1.2a2 2 0 0 0-2.8 0L4 16v4z"/><path d="M13.5 6.5l4 4"/>',
  trash:'<path d="M4 7h16"/><path d="M9 7V4.6A1.6 1.6 0 0 1 10.6 3h2.8A1.6 1.6 0 0 1 15 4.6V7"/><path d="M6.5 7l1 12.2A2 2 0 0 0 9.5 21h5a2 2 0 0 0 2-1.8L17.5 7"/>',
  briefcase:'<rect x="3" y="7.5" width="18" height="12.5" rx="2.5"/><path d="M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5"/>',
  home:'<path d="M4 11.5 12 4l8 7.5"/><path d="M6 10v9a1 1 0 0 0 1 1h4v-6h2v6h4a1 1 0 0 0 1-1v-9"/>',
  compass:'<circle cx="12" cy="12" r="9"/><polygon points="15.5 8.5 13.2 13.2 8.5 15.5 10.8 10.8 15.5 8.5"/>',
  users:'<circle cx="9" cy="8" r="3.4"/><path d="M2.5 20c0-3.6 2.9-5.6 6.5-5.6s6.5 2 6.5 5.6"/><path d="M16 4.8a3.4 3.4 0 0 1 0 6.4"/><path d="M18 14.6c2.1.6 3.5 2.3 3.5 5.4"/>',
  arrowRight:'<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>'
};
function ic(name, size){
  size = size || 20;
  return '<svg class="ic" viewBox="0 0 24 24" style="width:'+size+'px;height:'+size+'px;">'+ICONS[name]+'</svg>';
}
function fillIcons(){
  document.querySelectorAll('[data-ic]').forEach(el=>{
    el.innerHTML = ic(el.getAttribute('data-ic'), el.getAttribute('data-ic-size')||20);
  });
}

/* =========================================================================
   BASE DE DONNÉES — Supabase (projet « immotrack », dédié à Immo'Track).
   Les tables ne sont pas lisibles directement : tout passe par des fonctions
   serveur (RPC) qui vérifient le code d'accès de l'agence. La clé ci-dessous
   est la clé PUBLIQUE (anon) : elle peut figurer dans la page sans danger.
   Les paiements Stripe passent par la fonction serveur « api » ; la clé
   secrète Stripe n'est jamais présente dans ce fichier.
   ========================================================================= */
const SUPABASE_URL = 'https://jndnvvmjskezfvqphgdt.supabase.co';
const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpuZG52dm1qc2tlemZ2cXBoZ2R0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEzNTc4NTgsImV4cCI6MjEwNjkzMzg1OH0.09lpqiuQiCJqHQjRrIuQNziIaV2F5JV2HEacQL5H5Vw';
const SB_HEAD = { apikey:SUPABASE_KEY, Authorization:'Bearer '+SUPABASE_KEY, 'Content-Type':'application/json' };
const today10 = () => new Date().toISOString().slice(0,10);

async function sbFetch(url, body){
  let r;
  try{ r = await fetch(url, { method:'POST', headers:SB_HEAD, body:JSON.stringify(body || {}) }); }
  catch(e){ throw new Error('network'); }
  const t = await r.text();
  let j = null; try{ j = t ? JSON.parse(t) : null; }catch(e){}
  return { ok:r.ok, status:r.status, json:j };
}
/* Fonctions de la base (RPC) */
async function rpc(fn, args){
  const r = await sbFetch(SUPABASE_URL+'/rest/v1/rpc/'+fn, args);
  if(!r.ok){
    const err = new Error((r.json && (r.json.message || r.json.code)) || ('http_'+r.status));
    err.code = r.json && r.json.code;
    throw err;
  }
  return r.json;
}
/* Fonction serveur « api » : inscription, paiement Stripe, renouvellement, résiliation */
async function fnCall(action, b){
  const r = await sbFetch(SUPABASE_URL+'/functions/v1/api', Object.assign({ action:action }, b || {}));
  if(!r.ok || (r.json && r.json.error)) throw new Error((r.json && r.json.error) || ('http_'+r.status));
  return r.json || {};
}
/* Adresse de retour après un paiement Stripe : le site doit être servi en https (ou localhost) */
function returnUrl(){
  if(!/^https?:$/.test(location.protocol)) throw new Error('bad_return_url');
  return location.origin + location.pathname;
}

const TG_URL = 'https://t.me/aucunn';
function openTelegram(){ window.open(TG_URL, '_blank', 'noopener'); }
/* Anti-force-brute (côté client : à doubler côté serveur) */
const _att={};
function gateLeft(k){ const e=_att[k]; return e && e.until>Date.now() ? Math.ceil((e.until-Date.now())/1000) : 0; }
function gateFail(k){ const e=_att[k]||(_att[k]={n:0,until:0}); e.n++; if(e.n>=5){ e.until=Date.now()+60000; e.n=0; } }

let toastTimer = null;
/* Copie du code d'accès dans le presse-papiers */
async function copyAccessCode(){
  const input = document.getElementById('generated-code-display');
  const code = input.value;
  const btn = document.getElementById('copy-code-btn');
  let ok = false;
  try{
    if(navigator.clipboard && window.isSecureContext){ await navigator.clipboard.writeText(code); ok = true; }
  }catch(_){}
  if(!ok){
    try{
      input.removeAttribute('readonly');
      input.focus(); input.select(); input.setSelectionRange(0, code.length);
      ok = document.execCommand('copy');
      input.setAttribute('readonly','');
      input.blur();
    }catch(_){}
  }
  if(ok){
    showToast('Code copié !');
    if(btn){ btn.textContent = 'Code copié'; setTimeout(()=>{ btn.textContent = 'Copier le code'; }, 2000); }
  } else {
    showToast('Copie impossible : maintenez le code appuyé pour le copier.');
  }
}

function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 4200);
}
const DB_MSG = {
  inactive: "Votre compte est en pause ou n'est plus actif. Reconnectez-vous depuis l'accueil.",
  limit_reached: "Limite quotidienne atteinte. Réessayez demain.",
  suspended: "Votre compte est suspendu : plusieurs signalements ont été rejetés comme mensongers. Contactez l'administration.",
  invalid_media: "Une image est invalide ou trop lourde. Réduisez sa taille et réessayez.",
  invalid_report: "Le signalement est incomplet ou invalide.",
  invalid_date: "La date indiquée est invalide.",
  network: "Base de données injoignable. Vérifiez votre connexion."
};
function dbError(e){
  const m = (e && e.message) || '';
  if(m.indexOf('42501') !== -1){ showToast(DB_MSG.inactive); return; }
  showToast(DB_MSG[m] || "Une erreur est survenue lors de l'enregistrement. Réessayez.");
}

/* Le contenu saisi par une agence est affiché aux autres agences : il doit
   toujours être échappé pour empêcher toute injection de code. */
function esc(s){
  return String(s == null ? '' : s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function safeImg(src){
  return (typeof src === 'string' && src.startsWith('data:image/') && !/["'<>\s]/.test(src)) ? src : '';
}

/* Redimensionne / compresse une image avant enregistrement (base plus légère,
   envoi plus rapide) tout en gardant une carte d'identité lisible. */
function compressImage(file, maxDim, quality){
  return new Promise((resolve, reject)=>{
    const reader = new FileReader();
    reader.onerror = reject;
    reader.onload = e=>{
      const img = new Image();
      img.onerror = reject;
      img.onload = ()=>{
        const scale = Math.min(1, maxDim / Math.max(img.width, img.height));
        const w = Math.max(1, Math.round(img.width * scale)), h = Math.max(1, Math.round(img.height * scale));
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, w, h);
        ctx.drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL('image/jpeg', quality));
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  });
}

/* Session : l'agence reste connectée après un rechargement de la page */
const SESSION_KEY = 'immotrack_access_code';
function saveSession(code){ try{ localStorage.setItem(SESSION_KEY, code); }catch(e){} }
function loadSession(){ try{ return localStorage.getItem(SESSION_KEY); }catch(e){ return null; } }
function clearSession(){ try{ localStorage.removeItem(SESSION_KEY); }catch(e){} }

let reports = [];
let myStats = null; /* statistiques et limite quotidienne, calculées par le serveur */
let reportsLoaded = false;
let formPhotos = [];
let selectedPlanIndex = 0;
let renewCode = null; /* code de l'agence dont l'année gratuite est terminée (renouvellement : même compte) */
let editingId = null;
let deletingId = null;
let submittingReport = false;
let clusters = {};
let formGravity = 0;
let gravityTouched = false;

let currentAccessCode = null;
let currentProfile = null;
let adminCode = null;
let adminReports = [];
let adminAgencies = [];
let adminSelectedAgency = null;
let adminProfiles = {};

/* Stockage temporaire des images de carte d'identité en cours de dépôt */
let idData = { report:{recto:null, verso:null}, profile:{recto:null, verso:null}, verify:{recto:null, verso:null} };

async function loadReports(){
  if(!currentAccessCode) return;
  try{
    const list = await rpc('list_reports', { p_code: currentAccessCode });
    reports = (Array.isArray(list) ? list : []).map(normalizeReport);
    clusters = buildClusters(reports);
    reportsLoaded = true;
    try{ myStats = await rpc('my_stats', { p_code: currentAccessCode }); }catch(e){}
    await loadAvatars();
    renderRepCards();
  } catch(e){ dbError(e); }
}

/* =========================================================================
   NAVIGATION
   ========================================================================= */
let currentView = 'landing';
function goTo(name){
  currentView = name;
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-'+name).classList.add('active');
  document.getElementById('fab-home').classList.toggle('above-tabbar', name === 'app');
  if(name === 'app'){ renderHome(); }
  if(name === 'admin'){ renderAdmin(); }
  if(name === 'landing'){ renewCode = null; }
  if(name === 'subscription' || name === 'verify'){ applyRenewUi(); applyTypeUi(); }
  if(name === 'subscription'){ updateStripeButtonLabel(); }
}

let currentTab = 0;
function switchTab(index, dir){
  const panes = document.querySelectorAll('.tabpane');
  const tabs = document.querySelectorAll('.tab');
  if(!dir) dir = index > currentTab ? 'right' : 'left';
  panes.forEach(p=>{
    p.classList.remove('active','from-right','from-left');
  });
  const target = document.querySelector('.tabpane[data-pane="'+index+'"]');
  target.classList.add('active', dir === 'right' ? 'from-right' : 'from-left');
  tabs.forEach(t=>t.classList.toggle('active', t.getAttribute('data-tab') == index));
  currentTab = index;
  if(index === 2){ document.getElementById('f-search').focus(); }
}

/* swipe entre onglets */
(function(){
  let startX=0, startY=0, tracking=false;
  const body = document.querySelector('.app-body');
  body.addEventListener('touchstart', e=>{
    startX = e.touches[0].clientX; startY = e.touches[0].clientY; tracking = true;
  }, {passive:true});
  body.addEventListener('touchend', e=>{
    if(!tracking) return; tracking = false;
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    if(Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)){
      if(dx < 0 && currentTab < 2) switchTab(currentTab+1, 'right');
      if(dx > 0 && currentTab > 0) switchTab(currentTab-1, 'left');
    }
  }, {passive:true});
})();

/* ripple sur tous les .btn */
document.addEventListener('click', function(e){
  const btn = e.target.closest('.btn');
  if(!btn) return;
  const rect = btn.getBoundingClientRect();
  const r = document.createElement('span');
  const size = Math.max(rect.width, rect.height) * 1.2;
  r.className = 'ripple';
  r.style.width = r.style.height = size+'px';
  r.style.left = (e.clientX - rect.left - size/2)+'px';
  r.style.top = (e.clientY - rect.top - size/2)+'px';
  btn.appendChild(r);
  setTimeout(()=>r.remove(), 550);
});

/* =========================================================================
   ACCÈS ADHÉRENT
   ========================================================================= */
async function enterApp(code, profile){
  if(profile && profile.expired){
    clearSession();
    currentAccessCode = null; currentProfile = null;
    goTo('landing');
    renewCode = code;
    goTo('subscription');
    showToast("Votre année gratuite est terminée. Abonnez-vous : vous gardez le même code d'accès et le même compte.");
    return;
  }
  currentAccessCode = code;
  currentProfile = profile;
  saveSession(code);
  if(profile && profile.paused){ goTo('paused'); return; }
  await loadReports();
  goTo('app');
  maybeRemind(profile);
}
async function openBillingPortal(){
  try{
    const d = await fnCall('portal', { code: currentAccessCode, return_url: returnUrl() });
    if(d.url){ location.href = d.url; return; }
    throw new Error('no_url');
  }catch(e){
    const m = (e && e.message) || '';
    showToast(m === 'no_customer'
      ? "Aucun abonnement payant n'est lié à ce compte (année gratuite ou compte offert)."
      : m === 'bad_return_url'
        ? "Le portail de paiement nécessite que le site soit publié en ligne (adresse https)."
        : "Portail de paiement indisponible pour le moment. Réessayez plus tard.");
  }
}
function openCancelModal(){ document.getElementById('modal-cancel-sub').classList.add('active'); }
async function confirmCancelSub(){
  const btn = document.getElementById('cancel-sub-btn');
  btn.disabled = true;
  try{
    await fnCall('cancel', { code: currentAccessCode });
    closeModal('modal-cancel-sub');
    logout();
    showToast("Abonnement résilié. Votre code d'accès est désactivé et les prochains paiements sont annulés. La période en cours n'est pas remboursée.");
  }catch(e){
    btn.disabled = false;
    showToast("La résiliation a échoué. Réessayez ou contactez l'assistance.");
  }
}
async function submitAccessCode(){
  const val = document.getElementById('access-code').value.trim().toUpperCase();
  const errorEl = document.getElementById('access-error');
  errorEl.textContent = '';
  if(!val){ errorEl.textContent = 'Saisissez votre code.'; return; }
  const _w = gateLeft('access'); if(_w){ errorEl.textContent = 'Trop de tentatives. Réessayez dans '+_w+' s.'; return; }
  try{
    const profile = await rpc('login_agency', { p_code: val });
    if(profile && profile.locked){
      errorEl.textContent = 'Trop de tentatives. Réessayez dans quelques minutes.';
    } else if(profile){
      await enterApp(val, profile);
    } else {
      gateFail('access');
      errorEl.textContent = "Code invalide. Vérifiez le code fourni lors de votre adhésion.";
      const box = document.getElementById('view-access');
      box.classList.remove('shake'); void box.offsetWidth; box.classList.add('shake');
    }
  } catch(e){ dbError(e); }
}
function logout(){
  clearSession();
  currentAccessCode = null; currentProfile = null;
  reports = []; clusters = {}; reportsLoaded = false; myAvatar = null; avatarMap = {}; myStats = null;
  goTo('landing');
}
async function restoreSession(){
  const code = loadSession();
  if(!code) return;
  try{
    const profile = await rpc('login_agency', { p_code: code });
    if(profile && !profile.locked){ await enterApp(code, profile); } else if(!profile){ clearSession(); }
  } catch(e){ /* hors ligne : on reste sur l'accueil */ }
}

const PLAN_PRICES = {
  0: { amount:'29.90',  plan:'mensuel', label:"Abonnement mensuel Immo'Track" },
  1: { amount:'239.88', plan:'annuel',  label:"Abonnement annuel Immo'Track" },
  2: { amount:'0',      plan:'gratuit', label:"1 an gratuit Immo'Track" }
};

function applyRenewUi(){
  const on = !!renewCode;
  const sub = document.getElementById('view-subscription');
  const h1 = sub.querySelector('h1'), pp = h1 ? h1.nextElementSibling : null;
  if(h1 && pp){
    if(h1._o === undefined){ h1._o = h1.textContent; pp._o = pp.textContent; }
    h1.textContent = on ? 'Renouvelez votre accès' : h1._o;
    pp.textContent = on ? "Votre année gratuite est terminée. Choisissez un abonnement : vous gardez le même code d'accès et le même compte." : pp._o;
  }
  const free = sub.querySelector('.plan[data-plan="2"]');
  if(free) free.style.display = on ? 'none' : '';
  if(on && selectedPlanIndex === 2) selectPlan(0);
  /* Page de vérification : en renouvellement, l'agence est déjà vérifiée (seules les CGU restent) */
  const ver = document.getElementById('view-verify');
  const box = ver ? ver.children[1] : null;
  if(box){
    const kids = Array.from(box.children);
    const cguIdx = kids.findIndex(el=>el.classList.contains('section-label') && /^Conditions/.test(el.textContent.trim()));
    kids.forEach((el,i)=>{ if(i>0 && i<cguIdx) el.style.display = on ? 'none' : ''; });
    if(kids[0]){ if(kids[0]._o === undefined) kids[0]._o = kids[0].textContent; kids[0].textContent = on ? 'Confirmez votre abonnement' : kids[0]._o; }
  }
}
function selectPlan(i){
  selectedPlanIndex = i;
  document.querySelectorAll('.plan[data-plan]').forEach(p=>p.classList.remove('selected'));
  document.querySelector('.plan[data-plan="'+i+'"]').classList.add('selected');
  updateStripeButtonLabel();
}
function updateStripeButtonLabel(){
  const plan = PLAN_PRICES[selectedPlanIndex];
  if(!plan) return;
  const free = plan.plan === 'gratuit';
  const amt = plan.amount.replace('.',',')+'€';
  const payBtn = document.getElementById('stripe-pay-btn');
  const vBtn = document.getElementById('verify-pay-btn');
  /* Textes d'origine mémorisés une fois, pour revenir au paiement si on change de forfait */
  if(payBtn && !payBtn._orig){ payBtn._orig = payBtn.nextElementSibling ? payBtn.nextElementSibling.innerHTML : ''; }
  if(vBtn && !vBtn._origLabel){
    vBtn._origLabel = vBtn.previousElementSibling ? vBtn.previousElementSibling.textContent : '';
    vBtn._origHint = vBtn.nextElementSibling ? vBtn.nextElementSibling.innerHTML : '';
  }
  if(payBtn){
    payBtn.innerHTML = free ? 'Continuer' : 'Payer <span id="stripe-pay-amount">'+amt+'</span>';
    if(payBtn.nextElementSibling) payBtn.nextElementSibling.innerHTML = free
      ? "Étape suivante : vérification de votre identité, puis génération de votre code d'accès gratuit."
      : payBtn._orig;
  }
  if(vBtn){
    vBtn.innerHTML = free ? "Générer mon code d'accès" : 'Payer <span id="verify-pay-amount">'+amt+'</span> ';
    if(vBtn.previousElementSibling) vBtn.previousElementSibling.textContent = free ? 'Accès gratuit' : vBtn._origLabel;
    if(vBtn.nextElementSibling) vBtn.nextElementSibling.innerHTML = free
      ? "100% gratuit pendant 1 an : aucun paiement, aucune carte bancaire. Un code d'accès personnel est généré pour vous. Au bout d'un an, ce code cesse de fonctionner et vous pourrez vous abonner pour continuer."
      : vBtn._origHint;
  }
}

/* =========================================================================
   PAIEMENT STRIPE (mode test tant que la clé secrète Stripe du serveur est
   une clé « sk_test »). Le serveur crée la session de paiement Stripe ; le
   navigateur est redirigé vers la page Stripe puis revient ici avec
   ?paid=1&session_id=… : le serveur vérifie alors le paiement auprès de
   Stripe et crée le compte (un webhook sert de filet de sécurité).
   ========================================================================= */
function onCguToggle(){
  const c = document.getElementById('cgu-accept').checked;
  document.getElementById('verify-pay-btn').disabled = !c;
  document.getElementById('cgu-check-label').classList.remove('field-error');
}
/* Affiche le code d'accès d'un compte qui vient d'être créé */
async function showNewAccount(code){
  currentAccessCode = code;
  let p = null;
  try{ p = await rpc('login_agency', { p_code: code }); }catch(e){}
  currentProfile = (p && !p.locked) ? p : { agence:'', numero:'', emplacement:'', contact:'', plan:'' };
  reports = []; reportsLoaded = false; myStats = null;
  saveSession(code);
  document.getElementById('generated-code-display').value = code;
  goTo('code');
}
function checkoutError(e){
  const m = (e && e.message) || '';
  const map = {
    already_used: "Un compte ou une année gratuite existe déjà pour cette identité, ce n° SIRET ou ce bien. Connectez-vous avec votre code d'accès.",
    siret_not_found: "Ce n° SIRET n'existe pas dans l'annuaire officiel des entreprises. Vérifiez-le.",
    siret_closed: "Ce n° SIRET correspond à un établissement fermé. Saisissez le SIRET de votre structure en activité.",
    invalid_siret: 'Le n° SIRET doit comporter 14 chiffres.',
    minor: 'Vous devez être majeur pour vous inscrire.',
    invalid_id: "Le n° de pièce d'identité semble incomplet.",
    invalid_address: "Indiquez l'adresse complète du bien que vous louez.",
    invalid_holder: 'Informations du titulaire incomplètes ou invalides.',
    invalid_media: "Une image de la pièce d'identité est invalide ou trop lourde.",
    bad_return_url: "Le paiement nécessite que le site soit publié en ligne (adresse https) ou ouvert sur localhost.",
    stripe_not_configured: "Le paiement n'est pas encore activé côté serveur (clé Stripe manquante).",
    stripe_error: "Stripe a refusé la création du paiement. Réessayez dans un instant.",
    already_subscribed: "Cet abonnement est déjà actif.",
    inactive: "Ce code d'accès n'est plus actif.",
    network: "Serveur injoignable. Vérifiez votre connexion."
  };
  if(map[m]) showToast(map[m]); else dbError(e);
}

let ckBusy = false;
async function startStripeCheckout(){
  if(ckBusy) return;
  const plan = PLAN_PRICES[selectedPlanIndex].plan, f = readVerify(), cgu = document.getElementById('cgu-accept');
  if(!renewCode){
    if(!idData.verify.recto || !idData.verify.verso){ showToast("Ajoutez le recto ET le verso de la pièce d'identité."); return; }
    if(!f.nom || !f.prenom){ showToast('Indiquez votre nom et votre prénom.'); return; }
    if(!f.naissance || (Date.now() - Date.parse(f.naissance)) / 31557600000 < 18){ showToast('Date de naissance invalide : vous devez être majeur.'); return; }
    if(normPermis(f.idn).length < 5){ showToast("Le n° de pièce d'identité semble incomplet."); return; }
    if(f.type === 'pro' && !siretOk(f.siret)){ showToast("Ce n° SIRET n'est pas valide. Vérifiez-le (14 chiffres)."); return; }
    if(f.type !== 'pro' && f.addr.length < 8){ showToast("Indiquez l'adresse complète du bien que vous louez."); return; }
  }
  if(!cgu || !cgu.checked){ document.getElementById('cgu-check-label').classList.add('field-error'); showToast("Vous devez accepter les conditions générales d'utilisation."); return; }
  ckBusy = true;
  const btn = document.getElementById('verify-pay-btn');
  if(btn) btn.disabled = true;
  let redirecting = false;
  try{
    if(renewCode){
      if(plan === 'gratuit') throw new Error('invalid_plan');
      const res = await fnCall('renew', { code: renewCode, plan: plan, return_url: returnUrl() });
      if(!res.url) throw new Error('stripe_error');
      redirecting = true; location.href = res.url; return;
    }
    const body = { plan: plan, f: f, recto: idData.verify.recto, verso: idData.verify.verso };
    if(plan !== 'gratuit') body.return_url = returnUrl();
    const res = await fnCall('register', body);
    if(plan === 'gratuit'){
      if(!res.code) throw new Error('server_error');
      await showNewAccount(res.code);
      return;
    }
    if(!res.url) throw new Error('stripe_error');
    redirecting = true; location.href = res.url;
  }catch(e){ checkoutError(e); }
  finally{
    ckBusy = false;
    if(btn && !redirecting) btn.disabled = !(cgu && cgu.checked);
  }
}

/* Retour de la page de paiement Stripe : vérification côté serveur puis ouverture du compte */
async function handleStripeReturn(){
  const q = new URLSearchParams(location.search);
  const clean = () => { try{ history.replaceState(null, '', location.pathname); }catch(e){} };
  if(q.get('canceled')){ clean(); showToast("Paiement annulé : aucun montant n'a été débité."); return false; }
  const sid = q.get('session_id');
  if(q.get('paid') !== '1' || !sid) return false;
  showToast('Validation du paiement…');
  try{
    const res = await fnCall('confirm', { session_id: sid });
    clean();
    if(res.kind === 'renew'){
      const p = await rpc('login_agency', { p_code: res.code });
      renewCode = null;
      if(!p || p.locked) throw new Error('inactive');
      await enterApp(res.code, p);
      showToast("Abonnement activé. Vous gardez le même code d'accès et le même compte.");
      return true;
    }
    await showNewAccount(res.code);
    showToast("Paiement confirmé. Voici votre code d'accès : conservez-le.");
    return true;
  }catch(e){
    const m = (e && e.message) || '';
    if(m === 'network'){ showToast("Connexion impossible pour valider le paiement. Rechargez la page pour réessayer."); return false; }
    clean();
    if(m === 'already_used') showToast("Un compte existe déjà pour cette identité, ce n° SIRET ou ce bien : le paiement a été remboursé automatiquement.");
    else if(m === 'not_paid') showToast("Le paiement n'a pas été confirmé par Stripe. Aucun compte n'a été créé.");
    else showToast("Impossible de valider le paiement. Si vous avez été débité, contactez l'assistance avec votre reçu Stripe.");
    return false;
  }
}

/* =========================================================================
   PROFIL DE L'AGENCE — création à la souscription, modifiable à tout moment
   depuis l'accueil de l'espace adhérent.
   ========================================================================= */
function openProfileView(){
  if(!currentAccessCode) return;
  const p = currentProfile || {};
  document.getElementById('p-agence').value = p.agence || '';
  document.getElementById('p-emplacement').value = p.emplacement || '';
  document.getElementById('p-contact').value = p.contact || '';
  idData.profile.recto = null;
  idData.profile.verso = null;
  document.getElementById('p-siret').value = p.numero || '';
  const _pro = p.type !== 'particulier';
  document.getElementById('p-siret').closest('.field').style.display = _pro ? '' : 'none';
  document.getElementById('p-id-label').textContent = _pro ? "Carte d'identité du gérant" : "Votre pièce d'identité";
  const _sh = document.getElementById('profile-sub-hint');
  if(_sh){
    if(!_sh._orig) _sh._orig = _sh.textContent;
    if(p.plan === 'gratuit' && p.paidUntil){
      const _d = new Date(p.paidUntil);
      _sh.textContent = "Votre année gratuite est valable jusqu'au " + _d.toLocaleDateString('fr-FR') + ". À cette date, votre code d'accès cessera de fonctionner : vous pourrez alors vous abonner pour continuer.";
    } else { _sh.textContent = _sh._orig; }
  }
  renderAvatarPick();
  renderIdSlot('profile','recto');
  renderIdSlot('profile','verso');
  renderRepCards();
  goTo('profile');
}
async function saveProfile(){
  if(!currentAccessCode) return;
  const _sv = document.getElementById('p-siret').value.replace(/\D/g,'');
  if(_sv && _sv.length !== 14){ showToast('Le n° SIRET doit comporter 14 chiffres.'); return; }
  const next = {
    agence: document.getElementById('p-agence').value.trim(),
    numero: document.getElementById('p-siret').value.replace(/\D/g,''),
    emplacement: document.getElementById('p-emplacement').value.trim(),
    contact: document.getElementById('p-contact').value.trim(),
    idRecto: idData.profile.recto, idVerso: idData.profile.verso
  };
  try{
    const idR = next.idRecto || (currentProfile && currentProfile.idRecto) || null;
    const idV = next.idVerso || (currentProfile && currentProfile.idVerso) || null;
    const ok = await rpc('update_agency', {
      p_code: currentAccessCode, p_agence: next.agence,
      p_emplacement: next.emplacement, p_contact: next.contact,
      p_id_recto: idR, p_id_verso: idV
    });
    if(!ok){ showToast("Code d'accès invalide. Reconnectez-vous."); return; }
    currentProfile = Object.assign({}, currentProfile, next, { idRecto:idR, idVerso:idV });
    saveSession(currentAccessCode);
    if(!reportsLoaded) await loadReports();
    goTo('app');
    showToast('Profil enregistré');
  } catch(e){ dbError(e); }
}

/* =========================================================================
   BOUTON ACCUEIL — toujours visible, quelle que soit la page affichée
   ========================================================================= */
async function goHome(){
  if(currentAccessCode){
    if(!reportsLoaded) await loadReports();
    goTo('app');
    switchTab(0, 'left');
  } else {
    goTo('landing');
  }
}

/* =========================================================================
   CARTES D'IDENTITÉ — dépôt recto/verso (locataire signalé ou gérant)
   ========================================================================= */
async function handleIdSelect(evt, context, side){
  const file = evt.target.files && evt.target.files[0];
  evt.target.value = '';
  if(!file) return;
  try{
    idData[context][side] = await compressImage(file, 1400, 0.8);
    renderIdSlot(context, side);
  } catch(e){ showToast("Image illisible. Essayez un autre fichier."); }
}
function removeIdSlot(context, side){
  idData[context][side] = null;
  renderIdSlot(context, side);
}
function renderIdSlot(context, side){
  const slot = document.getElementById(context+'-id-'+side+'-slot');
  if(!slot) return;
  const src = idData[context][side];
  if(src){
    slot.classList.add('filled');
    slot.innerHTML = '<img src="'+src+'" onclick="event.stopPropagation(); openLightbox(this.src)">'
      + '<div class="photo-remove" onclick="event.stopPropagation(); removeIdSlot(\''+context+'\',\''+side+'\')">'+ic('x',12)+'</div>';
  } else {
    slot.classList.remove('filled');
    slot.innerHTML = ic('creditCard',22);
  }
}

/* =========================================================================
   ADMIN — le code admin est vérifié côté serveur (jamais présent dans ce fichier)
   ========================================================================= */
function openAdminModal(){
  document.getElementById('admin-code-input').value = '';
  document.getElementById('admin-error').textContent = '';
  document.getElementById('modal-admin-login').classList.add('active');
}
async function checkAdminCode(){
  const val = document.getElementById('admin-code-input').value.trim();
  const _w = gateLeft('admin'); if(_w){ document.getElementById('admin-error').textContent = 'Trop de tentatives. Réessayez dans '+_w+' s.'; return; }
  try{
    const ok = await rpc('admin_check', { p_admin_code: val });
    if(ok){
      adminCode = val;
      adminSelectedAgency = null;
      adminProfiles = {};
      const _as = document.getElementById('admin-search'); if(_as) _as.value = '';
      closeModal('modal-admin-login');
      goTo('admin');
    } else {
      gateFail('admin');
      document.getElementById('admin-error').textContent = 'Code incorrect.';
      const box = document.getElementById('modal-admin-login').querySelector('.modal-box');
      box.classList.remove('shake'); void box.offsetWidth; box.classList.add('shake');
    }
  } catch(e){ dbError(e); }
}

function closeModal(id){ document.getElementById(id).classList.remove('active'); }
function openLightbox(src){
  document.getElementById('lightbox-img').src = src;
  document.getElementById('modal-lightbox').classList.add('active');
}
function closeLightboxBg(e){
  if(e.target.id === 'modal-lightbox'){ closeModal('modal-lightbox'); }
}

/* =========================================================================
   PHOTOS — vrai dépôt de fichiers (FileReader), aperçu réel
   ========================================================================= */
async function handlePhotoSelect(evt){
  const files = Array.from(evt.target.files || []);
  evt.target.value = '';
  const remaining = 8 - formPhotos.length;
  for(const file of files.slice(0, remaining)){
    try{
      formPhotos.push(await compressImage(file, 1280, 0.72));
      renderPhotoGrid();
    } catch(e){ showToast("Une photo n'a pas pu être lue."); }
  }
}
function removePhoto(i){
  formPhotos.splice(i,1);
  renderPhotoGrid();
}
function renderPhotoGrid(){
  const grid = document.getElementById('photo-grid');
  grid.innerHTML = formPhotos.map((src,i)=>
    '<div class="photo-thumb"><img src="'+src+'" onclick="openLightbox(this.src)"><div class="photo-remove" onclick="event.stopPropagation(); removePhoto('+i+')">'+ic('x',12)+'</div></div>'
  ).join('') + '<div class="photo-add-tile" onclick="document.getElementById(\'f-photos-input\').click()">'+ic('camera',22)+'</div>';
}

/* =========================================================================
   TYPES D'INCIDENT, GRAVITÉ, MÉTADONNÉES
   Le type, la gravité et le n° de permis sont transmis à la base ET conservés
   dans un marqueur invisible en tête de la description : ils restent ainsi
   visibles par toutes les agences même si la table ne possède pas encore ces
   colonnes. Le marqueur est retiré à l'affichage.
   ========================================================================= */
const INCIDENT_TYPES = [
  {id:'loyer_impaye', label:'Loyers impayés', g:2},
  {id:'degradation', label:'Dégradations du logement', g:2},
  {id:'non_restitution', label:'Non-restitution des clés / maintien dans les lieux', g:3},
  {id:'sous_location', label:'Sous-location illicite', g:3},
  {id:'trouble', label:'Troubles de voisinage graves', g:2},
  {id:'faux_documents', label:'Faux documents (dossier de location)', g:4},
  {id:'occupation', label:'Occupation illicite (squat)', g:4},
  {id:'autre', label:'Autre', g:1}
];
const GRAVITY = [
  {l:1, label:'Faible',   color:'#2fd67f', desc:'Litige mineur, sans conséquence durable.'},
  {l:2, label:'Modéré',   color:'#f5d33d', desc:'Préjudice réel mais limité.'},
  {l:3, label:'Élevé',    color:'#ff7a1a', desc:'Préjudice important : vigilance recommandée.'},
  {l:4, label:'Critique', color:'#e6485a', desc:'Faits très graves : vigilance maximale.'}
];
function typeLabel(id){ const t = INCIDENT_TYPES.find(x=>x.id===id); return t ? t.label : 'Non précisé'; }
function gravMeta(l){ return GRAVITY.find(g=>g.l===Number(l)) || null; }
function gravPill(l){
  const g = gravMeta(l); if(!g) return '';
  return '<span class="grav-pill" style="--gc:'+g.color+'"><i class="grav-ico"></i>Gravité : '+g.label+'</span>';
}

const META_RE = /^\[\[LT:([^\]]*)\]\]\n?/;
function encodeDesc(text, meta){ return '[[LT:'+encodeURIComponent(JSON.stringify(meta))+']]\n'+(text||''); }
function decodeDesc(raw){
  raw = String(raw == null ? '' : raw);
  const m = raw.match(META_RE);
  if(!m) return { text:raw, meta:{} };
  let meta = {};
  try{ meta = JSON.parse(decodeURIComponent(m[1])) || {}; }catch(e){}
  return { text:raw.slice(m[0].length), meta };
}
function normalizeReport(r){
  const d = decodeDesc(r.description);
  const m = d.meta || {};
  r.description = d.text;
  r.type = r.type || m.t || '';
  r.gravite = parseInt(r.gravite || m.g, 10) || 0;
  r.numeroPermis = r.numeroPermis || m.pn || '';
  let pj = (r.prejudice === null || r.prejudice === undefined || r.prejudice === '') ? m.pj : r.prejudice;
  pj = (pj === null || pj === undefined || pj === '') ? NaN : Number(pj);
  r.prejudice = isFinite(pj) ? pj : null;
  const rg = r.regularise || m.rg || '';
  r.regularise = (typeof rg === 'string' && /^\d{4}-\d{2}-\d{2}/.test(rg)) ? rg.slice(0,10) : '';
  r.agenceAdresse = r.agenceAdresse || '';
  r.createdAt = String(r.createdAt || '');
  return r;
}

/* =========================================================================
   CORRESPONDANCE FLOUE — accents, fautes de frappe, inversion nom/prénom,
   noms composés (tirets, apostrophes, particules)
   ========================================================================= */
function normStr(s){
  return String(s == null ? '' : s).normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .toLowerCase().replace(/œ/g,'oe').replace(/æ/g,'ae').replace(/ß/g,'ss')
    .replace(/[^a-z0-9\s]/g,' ').replace(/\s+/g,' ').trim();
}
function normPermis(s){ return String(s == null ? '' : s).toUpperCase().replace(/[^A-Z0-9]/g,''); }
const PARTICLES = new Set(['de','du','des','la','le','les','d','l','van','von','der','den','da','di','do','dos','el','al']);
function nameTokens(r){
  const all = (normStr(r.nom)+' '+normStr(r.prenom)).split(' ').filter(Boolean);
  const core = all.filter(t=>!PARTICLES.has(t) && t.length > 1);
  return core.length ? core : all;
}
function tkOf(r){ return r._tk || (r._tk = nameTokens(r)); }
/* distance de Damerau-Levenshtein (les transpositions comptent pour 1 faute) */
function lev(a, b){
  if(a === b) return 0;
  const al = a.length, bl = b.length;
  if(!al) return bl; if(!bl) return al;
  const d = [];
  for(let i=0;i<=al;i++){ d[i] = [i]; }
  for(let j=1;j<=bl;j++){ d[0][j] = j; }
  for(let i=1;i<=al;i++){
    for(let j=1;j<=bl;j++){
      const c = a[i-1] === b[j-1] ? 0 : 1;
      d[i][j] = Math.min(d[i-1][j]+1, d[i][j-1]+1, d[i-1][j-1]+c);
      if(i>1 && j>1 && a[i-1] === b[j-2] && a[i-2] === b[j-1]) d[i][j] = Math.min(d[i][j], d[i-2][j-2]+1);
    }
  }
  return d[al][bl];
}
function tolFor(a, b){ const n = Math.min(a.length, b.length); return n <= 3 ? 0 : (n <= 6 ? 1 : 2); }
function tokEq(a, b){ return a === b || lev(a, b) <= tolFor(a, b); }
function namesMatch(a, b){
  const ta = tkOf(a), tb = tkOf(b);
  const short = ta.length <= tb.length ? ta : tb;
  const long = ta.length <= tb.length ? tb : ta;
  if(!short.length) return false;
  if(short.length < 2) return long.length === 1 && tokEq(short[0], long[0]);
  const used = new Set();
  for(const t of short){
    let found = -1;
    for(let i=0;i<long.length;i++){ if(!used.has(i) && tokEq(t, long[i])){ found = i; break; } }
    if(found < 0) return false;
    used.add(found);
  }
  return true;
}
/* dates de naissance : identiques, ou jour/mois inversés (saisie US) */
function sameDob(x, y){
  if(!x || !y || x === y) return true;
  const [y1,m1,d1] = x.split('-'), [y2,m2,d2] = y.split('-');
  return y1 === y2 && m1 === d2 && d1 === m2;
}
function samePerson(a, b){
  const pa = normPermis(a.numeroPermis), pb = normPermis(b.numeroPermis);
  if(pa.length >= 5 && pa === pb) return true;
  const dobOk = sameDob(a.naissance, b.naissance);
  const permisClose = pa.length >= 8 && pb.length >= 8 && lev(pa, pb) <= 1;
  if(!dobOk && !permisClose) return false;
  if(!namesMatch(a, b)) return false;
  return dobOk || permisClose;
}

/* =========================================================================
   DÉTECTION DE DOUBLONS — regroupe les signalements d'une même personne
   ========================================================================= */
function agKey(name){ return normStr(name); }
function buildClusters(list){
  const map = {};
  const active = list.filter(r=>r.statut !== 'rejete');
  const parent = active.map((_,i)=>i);
  const find = i=>{ while(parent[i] !== i){ parent[i] = parent[parent[i]]; i = parent[i]; } return i; };
  for(let i=0;i<active.length;i++){
    for(let j=i+1;j<active.length;j++){
      if(find(i) !== find(j) && samePerson(active[i], active[j])) parent[find(i)] = find(j);
    }
  }
  const groups = {};
  active.forEach((r,i)=>{ const k = find(i); (groups[k] = groups[k] || []).push(r); });
  Object.keys(groups).forEach(k=>{
    const members = groups[k].slice().sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)));
    const ags = new Set(members.map(r=>agKey(r.agence)).filter(Boolean));
    const c = { id:'c'+k, reports:members, agencyCount:Math.max(1, ags.size), maxG:Math.max.apply(null, members.map(r=>r.gravite||0)) };
    members.forEach(r=>{ map[r.id] = c; });
  });
  list.filter(r=>r.statut === 'rejete').forEach(r=>{
    map[r.id] = { id:'r'+r.id, reports:[r], agencyCount:0, maxG:r.gravite||0 };
  });
  return map;
}
function plural(n, one, many){ return n + ' ' + (n > 1 ? many : one); }
function dupBadge(c){
  if(!c || !c.agencyCount) return '';
  const n = c.reports.length;
  return '<span class="dup-badge clickable'+(n >= 2 ? ' multi' : '')+'" onclick="event.stopPropagation(); openLinked(\''+esc(c.reports[0].id)+'\')">'
    +ic('users',12)+'Signalé '+n+' fois'+ic('arrowRight',11)+'</span>';
}
function findMatches(cand){
  return reports.filter(r=>r.statut !== 'rejete' && samePerson(cand, r));
}
function updateDupHint(){
  const box = document.getElementById('dup-hint');
  if(!box) return;
  const cand = {
    nom: document.getElementById('f-nom').value, prenom: document.getElementById('f-prenom').value,
    naissance: document.getElementById('f-naissance').value, numeroPermis: document.getElementById('f-permis-num').value
  };
  const hasName = normStr(cand.nom) && normStr(cand.prenom);
  const hasPermis = normPermis(cand.numeroPermis).length >= 5;
  if(!hasName && !hasPermis){ box.classList.remove('show'); return; }
  const me = agKey(document.getElementById('f-agence').value);
  const found = findMatches(hasName ? cand : {nom:'', prenom:'', naissance:'', numeroPermis:cand.numeroPermis});
  if(!found.length){ box.classList.remove('show'); return; }
  const others = new Set(found.map(r=>agKey(r.agence)).filter(k=>k && k !== me));
  const mine = found.some(r=>agKey(r.agence) === me);
  let msg = '<div><b>Personne déjà connue du réseau.</b> ';
  if(others.size) msg += 'Elle a déjà été signalée par <b>'+plural(others.size,'autre adhérent','autres adhérents')+'</b>. Votre signalement renforcera la crédibilité du dossier.';
  else msg += 'Seule votre agence l\'a déjà signalée.';
  if(mine) msg += ' Vérifiez que ce sinistre n\'a pas déjà été déclaré par vous.';
  box.innerHTML = ic('users',18)+msg+'</div>';
  box.classList.add('show');
}

/* =========================================================================
   PRÉVENTION DES ABUS — limite quotidienne, sanctions, réputation
   ========================================================================= */
const DAILY_LIMIT = 5;
function todayStr(){ return new Date().toISOString().slice(0,10); }
function agencyStats(){
  return myStats || { rejected:0, limit:DAILY_LIMIT, sanction:'', today:0, total:0, regularises:0 };
}
/* Limite quotidienne et éventuelle sanction (onglet Signaler) */
function renderLimitInfo(){
  const box = document.getElementById('rep-report');
  if(!box) return;
  const name = (currentProfile && currentProfile.agence) || (document.getElementById('f-agence') ? document.getElementById('f-agence').value : '');
  if(!agKey(name)){
    box.innerHTML = '<div class="rules-box" style="margin-top:0;">Limite de <b>'+DAILY_LIMIT+' signalements par jour</b>. Un signalement reconnu mensonger est rejeté et sanctionné.</div>';
    return;
  }
  const s = agencyStats();
  let sanc = '';
  if(s.sanction === 'suspended') sanc = '<div class="rep-sanction">Signalement suspendu : '+plural(s.rejected,'signalement rejeté','signalements rejetés')+' comme mensonger(s). Contactez l\'administration pour rétablir l\'accès.</div>';
  else if(s.sanction === 'restricted') sanc = '<div class="rep-sanction">Accès restreint : '+plural(s.rejected,'signalement rejeté','signalements rejetés')+' comme mensonger(s). Limite réduite à '+s.limit+' par jour. Un rejet de plus entraînera la suspension.</div>';
  else if(s.sanction === 'warning') sanc = '<div class="rep-sanction warn">Avertissement : 1 signalement a été rejeté comme mensonger. Limite réduite à '+s.limit+' par jour.</div>';
  box.innerHTML = '<div class="rules-box" style="margin-top:0;">Aujourd\'hui : <b>'+s.today+' / '+s.limit+'</b> signalement(s). Un signalement reconnu mensonger est rejeté et sanctionné.</div>'+sanc;
}
/* Profil de l'adhérent : nombre de signalements + historique des clients signalés */
function renderAgencyHistory(){
  const box = document.getElementById('agency-history');
  if(!box) return;
  const name = (currentProfile && currentProfile.agence) || '';
  if(!agKey(name)){
    box.innerHTML = '<div class="rules-box" style="margin-top:0;">Renseignez votre nom (ou celui de votre agence) puis enregistrez votre profil pour retrouver ici vos signalements.</div>';
    return;
  }
  const mine = reports.filter(isMine);
  const s = agencyStats();
  box.innerHTML = '<div class="stat-row" style="margin-bottom:14px;">'
    +'<div class="stat-card"><div class="stat-num">'+mine.length+'</div><div class="stat-label">Signalements effectués</div></div>'
    +'<div class="stat-card"><div class="stat-num">'+s.regularises+'</div><div class="stat-label">Dont régularisés</div></div></div>'
    +(mine.length
      ? '<div class="section-title">Historique des clients signalés</div><div style="max-height:300px; overflow-y:auto;">'
        + mine.map(r=>{
            const m = effStatus(r);
            return '<div class="mini-row" onclick="openDetailById(\''+esc(r.id)+'\')">'
              +'<div class="mini-ic">'+ic('user',18)+'</div>'
              +'<div style="flex:1; min-width:0;"><div class="mini-name">'+esc(r.prenom)+' '+esc(r.nom)+'</div>'
              +'<div class="mini-sub">'+esc(typeLabel(r.type))+' · '+fmtDate(r.sinistre)+'</div>'
              +'<div class="pill-row"><div class="status-pill '+m.cls+'">'+m.label+'</div></div></div>'
              +ic('arrowRight',16)+'</div>';
          }).join('')
        + '</div>'
      : '<p>Aucun signalement pour le moment.</p>');
}
function renderRepCards(){ renderLimitInfo(); renderAgencyHistory(); }

/* =========================================================================
   Sélecteurs type d'incident + jauge de gravité (formulaire)
   ========================================================================= */
function initIncidentUi(){
  const sel = document.getElementById('f-type');
  sel.innerHTML = '<option value="">Choisir un type d\'incident…</option>'
    + INCIDENT_TYPES.map(t=>'<option value="'+t.id+'">'+esc(t.label)+'</option>').join('');
  document.getElementById('e-type').innerHTML = '<option value="">Non précisé</option>'
    + INCIDENT_TYPES.map(t=>'<option value="'+t.id+'">'+esc(t.label)+'</option>').join('');
  document.getElementById('e-gravite').innerHTML = '<option value="0">Non précisée</option>'
    + GRAVITY.map(g=>'<option value="'+g.l+'">'+g.label+'</option>').join('');
  document.getElementById('gauge').innerHTML = GRAVITY.map(g=>
    '<button type="button" class="gseg" data-l="'+g.l+'" style="--gc:'+g.color+'" onclick="setGravity('+g.l+', true)"><i></i><span>'+g.label+'</span></button>'
  ).join('');
  renderGauge();
}
function renderGauge(){
  document.querySelectorAll('#gauge .gseg').forEach(b=>{
    const l = Number(b.getAttribute('data-l'));
    b.classList.toggle('on', l <= formGravity);
    b.classList.toggle('cur', l === formGravity);
  });
  const g = gravMeta(formGravity);
  document.getElementById('gauge-caption').innerHTML = g
    ? '<b style="color:'+g.color+'">'+g.label+'</b> — '+esc(g.desc)
    : 'Sélectionnez un niveau de gravité pour aider les adhérents à juger vite.';
}
function setGravity(l, manual){
  formGravity = (manual && l === formGravity) ? 0 : l;
  if(manual) gravityTouched = true;
  renderGauge();
}
function onTypeChange(){
  const t = INCIDENT_TYPES.find(x=>x.id === document.getElementById('f-type').value);
  if(t && !gravityTouched) setGravity(t.g, false);
  togglePrejudice();
}
/* Pas de préjudice (donc pas de remboursement) pour de faux documents */
function togglePrejudice(){
  const wrap = document.getElementById('f-prejudice-wrap');
  if(!wrap) return;
  const noDamage = document.getElementById('f-type').value === 'faux_documents';
  wrap.style.display = noDamage ? 'none' : '';
  if(noDamage) document.getElementById('f-prejudice').value = '';
}
function parseMoney(raw){
  raw = String(raw || '').trim();
  if(!raw) return null;
  const n = parseFloat(raw.replace(/\s/g,'').replace(',', '.').replace(/€/g,''));
  return (isFinite(n) && n >= 0 && n <= 1000000) ? Math.round(n*100)/100 : NaN;
}

/* =========================================================================
   FORMULAIRE DE SIGNALEMENT
   ========================================================================= */
function openReportForm(){
  ['f-agence','f-nom','f-prenom','f-naissance','f-permis-num','f-type','f-sinistre','f-vehicule','f-prejudice','f-description']
    .forEach(id=>document.getElementById(id).value = '');
  document.getElementById('f-certify').checked = false;
  togglePrejudice();
  const fa = document.getElementById('f-agence');
  if(currentProfile && currentProfile.agence){ fa.value = currentProfile.agence; fa.readOnly = true; }
  else { fa.readOnly = false; }
  formGravity = 0; gravityTouched = false; renderGauge();
  document.getElementById('dup-hint').classList.remove('show');
  renderRepCards();
  formPhotos = [];
  renderPhotoGrid();
  switchTab(1);
}

/* Champs obligatoires : on nomme précisément ce qui manque, on le surligne et on y fait défiler la page */
const REQUIRED_FIELDS = [
  ['f-agence', "Nom (agence, conciergerie ou bailleur)"], ['f-nom', 'Nom'], ['f-prenom', 'Prénom'],
  ['f-naissance', 'Date de naissance'], ['f-permis-num', "Numéro de pièce d'identité"],
  ['f-type', "Type d'incident"], ['f-sinistre', 'Date du sinistre'], ['f-vehicule', 'Commune / type de logement']
];
function checkRequiredFields(){
  document.querySelectorAll('.field-error').forEach(el=>el.classList.remove('field-error'));
  const missing = REQUIRED_FIELDS.filter(([id])=>!String(document.getElementById(id).value || '').trim());
  if(!missing.length) return true;
  missing.forEach(([id])=>{
    const box = document.getElementById(id).closest('.field');
    if(box) box.classList.add('field-error');
  });
  const first = document.getElementById(missing[0][0]);
  try{ first.scrollIntoView({ behavior:'smooth', block:'center' }); }catch(e){}
  setTimeout(()=>{ try{ first.focus({ preventScroll:true }); }catch(e){} }, 350);
  showToast((missing.length > 1 ? 'Champs manquants : ' : 'Champ manquant : ') + missing.map(m=>m[1]).join(', '));
  return false;
}
document.addEventListener('input', e=>{ const f = e.target.closest && e.target.closest('.field'); if(f) f.classList.remove('field-error'); });
document.addEventListener('change', e=>{ const f = e.target.closest && e.target.closest('.field'); if(f) f.classList.remove('field-error'); });

let pendingReport = null;
async function submitReport(){
  if(submittingReport) return;
  if(!currentAccessCode){ showToast("Connectez-vous avec votre code adhérent."); return; }
  const agence = document.getElementById('f-agence').value.trim();
  const nom = document.getElementById('f-nom').value.trim();
  const prenom = document.getElementById('f-prenom').value.trim();
  const naissance = document.getElementById('f-naissance').value;
  const numeroPermis = document.getElementById('f-permis-num').value.trim();
  const type = document.getElementById('f-type').value;
  const sinistre = document.getElementById('f-sinistre').value;
  const vehicule = document.getElementById('f-vehicule').value.trim();
  const description = document.getElementById('f-description').value.trim();
  const certify = document.getElementById('f-certify').checked;

  if(!checkRequiredFields()) return;
  if(!formGravity){ alert('Sélectionnez un niveau de gravité (vert, jaune, orange ou rouge).'); return; }
  if(normPermis(numeroPermis).length < 5){ alert('Le numéro de pièce d\'identité semble incomplet.'); return; }
  if(!certify){
    alert("Vous devez certifier l'exactitude des informations avant d'enregistrer.");
    return;
  }
  let prejudice = null;
  if(type !== 'faux_documents'){
    prejudice = parseMoney(document.getElementById('f-prejudice').value);
    if(Number.isNaN(prejudice)){ alert('Le montant du préjudice est invalide (nombre positif attendu).'); return; }
  }

  /* Prévention des abus : sanctions puis limite quotidienne */
  const st = agencyStats();
  if(st.sanction === 'suspended'){
    alert("Votre compte est suspendu : plusieurs de ses signalements ont été rejetés comme mensongers. Contactez l'administration.");
    return;
  }
  if(st.today >= st.limit){
    alert('Limite quotidienne atteinte : votre compte peut enregistrer '+plural(st.limit,'signalement','signalements')+' par jour'+(st.sanction ? ' (limite réduite suite à une sanction)' : '')+'. Réessayez demain.');
    return;
  }

  /* Détection de doublons */
  const cand = { nom, prenom, naissance, numeroPermis };
  const same = findMatches(cand);
  const me = agKey(agence);
  if(same.some(r=>agKey(r.agence) === me && r.sinistre === sinistre)){
    alert('Vous avez déjà signalé cette personne pour un sinistre à cette date.');
    return;
  }
  const otherAgencies = new Set(same.map(r=>agKey(r.agence)).filter(k=>k && k !== me));

  /* Pop-up de rappel avant l'enregistrement définitif */
  pendingReport = { agence, nom, prenom, naissance, numeroPermis, type, sinistre, vehicule, description, prejudice, otherAgencies:otherAgencies.size };
  document.getElementById('modal-rgpd-warn').classList.add('active');
}
async function confirmSubmitReport(){
  closeModal('modal-rgpd-warn');
  const p = pendingReport;
  if(!p || submittingReport) return;
  submittingReport = true;
  showToast('Enregistrement du signalement…');
  try{
    await rpc('create_report', { p_code: currentAccessCode, p_data: {
      agence:p.agence, nom:p.nom, prenom:p.prenom, naissance:p.naissance, sinistre:p.sinistre, vehicule:p.vehicule,
      type:p.type, gravite: formGravity, numeroPermis:p.numeroPermis, prejudice:p.prejudice,
      description: p.description,
      photos: formPhotos
    }});
    await loadReports();
    document.getElementById('confirm-msg').textContent = p.otherAgencies
      ? 'Cette personne était déjà signalée par '+plural(p.otherAgencies,'autre adhérent','autres adhérents')+' : elle l\'est désormais par '+plural(p.otherAgencies+1,'adhérent','adhérents')+'.'
      : 'Le signalement est désormais visible par les adhérents du réseau.';
    document.getElementById('modal-confirm').classList.add('active');
    startConfirmCountdown(5);
  } catch(e){ dbError(e); }
  finally{ submittingReport = false; pendingReport = null; }
}

/* Après confirmation d'un signalement : retour automatique à l'accueil au bout de 5 secondes */
let confirmTimer = null;
function stopConfirmCountdown(){ clearInterval(confirmTimer); confirmTimer = null; }
function startConfirmCountdown(sec){
  stopConfirmCountdown();
  const el = document.getElementById('confirm-countdown');
  let left = sec;
  const render = ()=>{ el.textContent = "Retour automatique à l'accueil dans "+left+" s"; };
  render();
  confirmTimer = setInterval(()=>{
    left--;
    if(left <= 0){ confirmGoHome(); return; }
    render();
  }, 1000);
}
function confirmGoHome(){
  stopConfirmCountdown();
  closeModal('modal-confirm');
  goHome();
}

/* =========================================================================
   ACCUEIL
   ========================================================================= */
function initialsOf(name){
  const clean = (name||'').trim();
  if(!clean) return '?';
  return clean.split(/\s+/).filter(Boolean).slice(0,2).map(w=>w[0].toUpperCase()).join('');
}
function renderHome(){
  const p = currentProfile || {};
  const name = p.agence || 'Mon compte';
  document.getElementById('agency-display-name').textContent = name;
  document.getElementById('agency-initials').innerHTML = avatarInner(name, ownAvatar());
  document.getElementById('stat-total').textContent = reports.length;
  const thisMonth = new Date().toISOString().slice(0,7);
  document.getElementById('stat-month').textContent = reports.filter(r=>r.createdAt.startsWith(thisMonth)).length;

  const recent = reports.slice(0,3);
  document.getElementById('recent-list').innerHTML = recent.map(r=>
    '<div class="mini-row" onclick="openDetailById(\''+r.id+'\')">'
    +'<div class="mini-ic">'+ic('alertTriangle',18)+'</div>'
    +'<div style="flex:1;"><div class="mini-name">'+esc(r.prenom)+' '+esc(r.nom)+'</div>'
    +'<div class="mini-sub">'+esc(typeLabel(r.type))+' · '+esc(r.vehicule)+' · '+esc(r.agence)+'</div></div>'
    +(gravMeta(r.gravite) ? '<span class="grav-pill" style="--gc:'+gravMeta(r.gravite).color+'; margin:0;" title="Gravité"><i class="grav-ico"></i>'+gravMeta(r.gravite).label+'</span>' : '')
    +'</div>'
  ).join('') || '<p>Aucun signalement pour le moment.</p>';
}

/* =========================================================================
   RECHERCHE
   ========================================================================= */
function statusMeta(statut){
  if(statut === 'confirme') return {label:'Confirmé', cls:'status-confirme'};
  if(statut === 'conteste') return {label:'Contesté', cls:'status-conteste'};
  if(statut === 'rejete') return {label:'Rejeté', cls:'status-attente'};
  return {label:'En attente de vérification', cls:'status-attente'};
}
function tokenHit(q, t){
  return t.startsWith(q) || (q.length >= 3 && t.includes(q)) || tokEq(q, t) || (q.length >= 4 && lev(q, t.slice(0, q.length)) <= 1);
}
function runSearch(){
  const raw = document.getElementById('f-search').value.trim();
  const container = document.getElementById('search-results');
  const qt = normStr(raw).split(' ').filter(Boolean);
  const qp = normPermis(raw);
  if(!qt.length && qp.length < 4){
    container.innerHTML = '<div class="empty-state"><div class="ic-circle">'+ic('compass',26)+'</div><p>Tapez un nom ou un n° de pièce d\'identité pour lancer une recherche</p></div>';
    return;
  }
  const matches = reports.filter(r=>{
    const tokens = normStr(r.nom+' '+r.prenom).split(' ').filter(Boolean);
    const byName = qt.length > 0 && qt.every(q=>tokens.some(t=>tokenHit(q, t)));
    const byPermis = qp.length >= 4 && normPermis(r.numeroPermis).includes(qp);
    return byName || byPermis;
  });
  if(matches.length === 0){
    container.innerHTML = '<div class="empty-state"><div class="ic-circle">'+ic('checkCircle',26)+'</div><p>Aucun signalement trouvé</p></div>';
    return;
  }
  /* un résultat par personne (doublons regroupés) */
  const seen = new Set(), groups = [];
  matches.forEach(r=>{
    const c = clusters[r.id];
    const key = c ? c.id : r.id;
    if(seen.has(key)) return;
    seen.add(key);
    groups.push({ c, rep: c ? c.reports[0] : r });
  });
  container.innerHTML = groups.map((g,i)=>{
    const r = g.rep, meta = effStatus(r);
    return '<div class="result-card" style="animation-delay:'+(i*70)+'ms" onclick="openDetailById(\''+esc(r.id)+'\')">'
      +'<div class="mini-ic">'+ic('user',18)+'</div>'
      +'<div style="flex:1; min-width:0;"><div class="mini-name">'+esc(r.prenom)+' '+esc(r.nom)+'</div>'
      +'<div class="mini-sub">'+esc(typeLabel(r.type))+' · '+esc(r.agence)+'</div>'
      +'<div class="pill-row"><div class="status-pill '+meta.cls+'">'+meta.label+'</div>'
      +gravPill(g.c ? g.c.maxG : r.gravite)+dupBadge(g.c)+'</div></div>'
      +ic('arrowRight',16)
      +'</div>';
  }).join('');
}

/* =========================================================================
   DÉTAIL
   ========================================================================= */
function fmtEuro(n){ return Number(n).toLocaleString('fr-FR', { style:'currency', currency:'EUR' }); }
function effStatus(r){
  if(r.regularise && r.statut !== 'rejete') return { label:'Régularisé', cls:'status-regularise' };
  return statusMeta(r.statut);
}
function isMine(r){
  return !!(currentProfile && currentProfile.ref && r.authorRef === currentProfile.ref);
}
function agAddr(r){
  return r.agenceAdresse || (isMine(r) && currentProfile && currentProfile.emplacement) || '';
}

/* --- Régularisation (loyers réglés, clés restituées) : réservée à l'agence auteure --- */
function regulariseBlock(r){
  if(!isMine(r) || r.statut === 'rejete') return '';
  if(r.regularise){
    return '<div class="section-label">Suivi</div>'
      +'<button class="btn secondary" onclick="unregularise(\''+esc(r.id)+'\')">Annuler la régularisation</button>';
  }
  return '<div class="section-label">Suivi</div>'
    +'<button class="btn" onclick="openRegulariseModal(\''+esc(r.id)+'\')">'+ic('checkCircle',18)+'Marquer comme régularisé</button>'
    +'<div class="hint">À utiliser quand l\'impayé est réglé ou que le véhicule a été restitué.</div>';
}
let regTargetId = null;
function openRegulariseModal(id){
  regTargetId = id;
  document.getElementById('reg-date').value = todayStr();
  document.getElementById('modal-regularise').classList.add('active');
}
async function saveReportMeta(r, patch){
  const ok = await rpc('set_report_regularise', { p_code: currentAccessCode, p_id: r.id, p_date: patch.rg || null });
  if(!ok){ showToast("Modification refusée : ce signalement n'appartient pas à votre compte."); return false; }
  return true;
}
async function confirmRegularise(){
  const r = reports.find(x=>x.id === regTargetId);
  const date = document.getElementById('reg-date').value;
  if(!r) return;
  if(!date){ showToast('Choisissez la date de régularisation.'); return; }
  try{
    if(await saveReportMeta(r, { rg:date })){
      closeModal('modal-regularise');
      await loadReports();
      showToast('Signalement marqué comme régularisé');
      openDetailById(r.id);
    }
  } catch(e){ dbError(e); }
}
async function unregularise(id){
  const r = reports.find(x=>x.id === id);
  if(!r) return;
  try{
    if(await saveReportMeta(r, { rg:'' })){
      await loadReports();
      showToast('Régularisation annulée');
      openDetailById(id);
    }
  } catch(e){ dbError(e); }
}

/* --- Tous les signalements liés à une même personne --- */
let linkedBack = 'app';
function openLinked(id){
  const c = clusters[id];
  if(!c) return;
  const list = c.reports, first = list[0];
  if(currentView !== 'linked') linkedBack = currentView;
  document.getElementById('linked-content').innerHTML =
    '<div class="detail-header"><div class="avatar-ring">'+ic('user',24)+'</div><div><h2>'+esc(first.prenom)+' '+esc(first.nom)+'</h2>'
    +'<div class="mini-sub" style="margin-top:4px;">Signalé '+list.length+' fois · '+plural(c.agencyCount,'adhérent','adhérents')+'</div></div></div>'
    +'<div class="section-label" style="margin-top:0;">Tous les signalements ('+list.length+')</div>'
    +list.map(x=>{
      const m = effStatus(x);
      return '<div class="mini-row" onclick="openDetailById(\''+esc(x.id)+'\')">'
        +'<div class="mini-ic">'+ic('alertTriangle',18)+'</div>'
        +'<div style="flex:1; min-width:0;"><div class="mini-name">'+agencyTag(x.agence, x.authorRef)+(isMine(x) ? ' · vous' : '')+'</div>'
        +'<div class="mini-sub">'+esc(agAddr(x) || 'Adresse non renseignée')+'</div>'
        +'<div class="mini-sub">'+esc(typeLabel(x.type))+' · '+fmtDate(x.sinistre)+(x.prejudice !== null ? ' · '+esc(fmtEuro(x.prejudice)) : '')+'</div>'
        +'<div class="pill-row"><div class="status-pill '+m.cls+'">'+m.label+'</div>'+gravPill(x.gravite)+'</div></div>'
        +ic('arrowRight',16)+'</div>';
    }).join('');
  goTo('linked');
}
function closeLinked(){ goTo(linkedBack || 'app'); }

function fmtDate(iso){
  if(!iso) return '—';
  iso = String(iso);
  if(iso.indexOf('T') !== -1){ const dt = new Date(iso); return isNaN(dt) ? '—' : dt.toLocaleDateString('fr-FR'); }
  const [y,m,d] = iso.split('-'); return d+'/'+m+'/'+y;
}
async function openDetailById(id){
  const r = reports.find(x=>x.id===id);
  if(!r) return;
  /* Photos du sinistre et cartes d'identité : chargées à la demande depuis la base */
  if(!r.mediaLoaded && (r.photoCount > 0 || r.hasId)){
    showToast('Chargement du dossier…');
    try{
      const m = await rpc('get_report_media', { p_code: currentAccessCode, p_id: id });
      if(m){
        r.photos = (m.photos || []).map(safeImg).filter(Boolean);
        r.idRecto = safeImg(m.idRecto) || null;
        r.idVerso = safeImg(m.idVerso) || null;
        r.mediaLoaded = true;
      }
    } catch(e){ dbError(e); }
  }
  const meta = effStatus(r);
  document.getElementById('detail-content').innerHTML =
    '<div class="detail-header"><div class="avatar-ring">'+ic('user',24)+'</div>'
    +'<div><h2>'+esc(r.prenom)+' '+esc(r.nom)+'</h2><div class="pill-row" style="margin-top:6px;"><div class="status-pill '+meta.cls+'" style="margin-top:4px;">'+meta.label+'</div>'+gravPill(r.gravite)+dupBadge(clusters[r.id])+'</div></div></div>'
    +row('Type d\'incident', typeLabel(r.type))
    +'<div class="info-row"><div class="info-label">Déclarant</div><div class="info-value">'+agencyTag(r.agence, r.authorRef)+'</div></div>'
    +row('Adresse du déclarant', agAddr(r) || '—')
    +row('Date de naissance', fmtDate(r.naissance))
        +row('N° de pièce d\'identité', r.numeroPermis || '—')
        +row('Commune / type de logement', r.vehicule)
    +row('Date du sinistre', fmtDate(r.sinistre))
    +(r.prejudice !== null ? row('Montant du préjudice', fmtEuro(r.prejudice)) : '')
    +(r.regularise ? row('Régularisé le', fmtDate(r.regularise)) : '')
    +row('Conservation jusqu\'au', fmtDate(r.expiration))
    +'<div class="section-label">Description</div><p>'+(esc(r.description)||'—')+'</p>'
    +(r.photos && r.photos.length ? '<div class="section-label">Photos</div><div class="photo-grid">'+r.photos.map(p=>'<div class="photo-thumb"><img src="'+p+'" onclick="openLightbox(this.src)"></div>').join('')+'</div>' : '')
    +(function(){
      const c = clusters[r.id];
      if(!c || c.reports.length < 2) return '';
      return '<div class="section-label">Signalements concordants ('+plural(c.agencyCount,'adhérent','adhérents')+')</div>'
        + c.reports.filter(x=>x.id !== r.id).map(x=>
          '<div class="mini-row" onclick="openDetailById(\''+esc(x.id)+'\')"><div class="mini-ic">'+ic('alertTriangle',18)+'</div>'
          +'<div style="flex:1;"><div class="mini-name">'+esc(x.agence)+'</div>'
          +'<div class="mini-sub">'+esc(typeLabel(x.type))+' · '+fmtDate(x.sinistre)+'</div></div>'
          +(gravMeta(x.gravite) ? '<span class="grav-pill" style="--gc:'+gravMeta(x.gravite).color+'; margin:0;"><i class="grav-ico"></i>'+gravMeta(x.gravite).label+'</span>' : '')
          +'</div>').join('');
    })()
    +regulariseBlock(r)
    +'<div class="info-box">'+ic('info',18)+'<div>Ce signalement a été déclaré par l\'agence, qui s\'est engagée à informer le locataire dans son contrat. Pour toute réclamation : <a href="https://t.me/aucunn" target="_blank" rel="noopener" style="color:var(--primary); text-decoration:underline;">t.me/aucunn</a> (Telegram).</div></div>';
  goTo('detail');
}
function row(label, value){
  return '<div class="info-row"><div class="info-label">'+esc(label)+'</div><div class="info-value">'+esc(value)+'</div></div>';
}

/* =========================================================================
   ADMIN — édition / suppression
   ========================================================================= */
let agencyActionType = null;
function askAgencyAction(type){
  const a = adminAgencies.find(x=>x.accessCode === adminSelectedAgency);
  if(!a) return;
  agencyActionType = type;
  const name = a.agence || 'cet adhérent';
  const btn = document.getElementById('aa-confirm');
  let title, text, label, danger = true;
  if(type === 'delete'){
    title = 'Supprimer ce compte ?';
    text = "Le compte de « "+name+" » sera supprimé définitivement : code d'accès, paiements, profil, CNI et SIRET. Ses signalements restent visibles dans le réseau. Action irréversible.";
    label = 'Supprimer';
  } else if(a.revoked){
    title = "Rétablir le code d'accès ?";
    text = "L'agence « "+name+" » pourra de nouveau se connecter avec son code.";
    label = 'Rétablir'; danger = false;
  } else {
    title = "Radier le code d'accès ?";
    text = "L'agence « "+name+" » ne pourra plus se connecter (impayé, résiliation). Ses données et ses signalements sont conservés, et vous pourrez rétablir le code à tout moment.";
    label = 'Radier le code';
  }
  document.getElementById('aa-title').textContent = title;
  document.getElementById('aa-text').textContent = text;
  btn.textContent = label;
  btn.className = 'btn' + (danger ? ' danger' : '');
  document.getElementById('modal-agency-action').classList.add('active');
}
async function confirmAgencyAction(){
  const code = adminSelectedAgency;
  const a = adminAgencies.find(x=>x.accessCode === code);
  if(!code || !a || !adminCode) return;
  const type = agencyActionType;
  try{
    const ok = type === 'delete'
      ? await rpc('admin_delete_agency', { p_admin_code: adminCode, p_access_code: code })
      : await rpc('admin_revoke_agency', { p_admin_code: adminCode, p_access_code: code, p_revoke: !a.revoked });
    closeModal('modal-agency-action');
    if(!ok){ showToast('Action refusée.'); return; }
    const msg = type === 'delete' ? 'Compte supprimé' : (a.revoked ? "Code d'accès rétabli" : "Code d'accès radié");
    if(type === 'delete'){ adminSelectedAgency = null; delete adminProfiles[code]; }
    await renderAdmin();
    showToast(msg);
  } catch(e){ dbError(e); }
}

function planLabel(a){ return (a.type==='particulier'?'Particulier · ':'Pro · ')+planLabel0(a); }
function planLabel0(a){
  if(!a.plan) return 'Sans paiement';
  if(a.plan === 'gratuit'){
    let g = 'Gratuit 1 an';
    if(a.subStatus === 'canceled') g += ' · Résilié';
    else if(a.expired) g += ' · EXPIRÉ le ' + fmtDate(a.paidUntil);
    else g += ' · expire le ' + fmtDate(a.paidUntil);
    return g;
  }
  const name = a.plan === 'annuel' ? 'Annuel' : (a.plan === 'mensuel' ? 'Mensuel' : 'Offert');
  const via = a.method === 'stripe' ? 'Stripe' : (a.method === 'paypal' ? 'PayPal' : (a.method === 'card' ? 'Carte' : 'Manuel'));
  let label = name + (a.hadFree ? ' (ex-gratuit)' : '') + ' · ' + via;
  if(a.subStatus === 'paused') label += ' · EN PAUSE (paiement non reçu)';
  else if(a.subStatus === 'canceled') label += ' · Résilié';
  else if(a.paidUntil) label += ' · payé jusqu\'au ' + fmtDate(a.paidUntil);
  return label;
}
async function renderAdmin(){
  const list = document.getElementById('admin-list');
  if(!adminCode){ list.innerHTML = ''; return; }
  list.innerHTML = '<p>Chargement…</p>';
  try{
    const [rep, ag] = await Promise.all([
      rpc('admin_list_reports', { p_admin_code: adminCode }),
      rpc('admin_list_agencies', { p_admin_code: adminCode })
    ]);
    if(rep === null){ adminCode = null; list.innerHTML = '<p>Session admin expirée.</p>'; return; }
    adminReports = (Array.isArray(rep) ? rep : []).map(normalizeReport); adminAgencies = ag || [];
  } catch(e){ list.innerHTML = ''; dbError(e); return; }

  renderAdminList();
}

function adminAgencyCard(a, clickable){
  const s = { total:a.total || 0, rejected:a.rejected || 0, sanction:a.sanction || '' };
  return '<div class="admin-row"'+(clickable ? ' style="cursor:pointer;" onclick="selectAdminAgency(\''+esc(a.accessCode)+'\')"' : '')+'><div class="admin-row-top"><div>'
    +'<div class="mini-name">'+esc(a.agence || 'Profil non renseigné')+(a.numero ? ' · '+esc(a.numero) : '')+'</div>'
    +'<div class="mini-sub">Code : '+esc(a.accessCode)+'</div>'
    +'<div class="mini-sub" style="font-weight:700;">'+plural(s.total,'signalement','signalements')+' · '+s.rejected+' rejeté(s)'+(s.sanction ? ' · sanction active' : '')+'</div>'
    +'<div class="mini-sub">'+esc(planLabel(a))+' · '+(a.plan === 'gratuit' ? 'souscrit le ' : 'inscrite le ')+fmtDate(a.createdAt)+'</div>'
    +(a.revoked ? '<div class="mini-sub" style="color:var(--danger); font-weight:800;">Code d\'accès radié</div>' : '')
    +(a.siretName ? '<div class="mini-sub">SIRET vérifié : '+esc(a.siretName)+'</div>' : '')
    +(a.expired ? '<div class="mini-sub" style="color:var(--danger); font-weight:800;">Année gratuite terminée · code désactivé · doit s\'abonner</div>' : '')
    +(a.emplacement ? '<div class="mini-sub">'+esc(a.emplacement)+'</div>' : '')
    +(a.contact ? '<div class="mini-sub">'+esc(a.contact)+'</div>' : '')
    +'</div></div></div>';
}

/* Profil complet de l'agence (écran admin) : nom, carte d'identité du gérant
   recto/verso, emplacement et contact. Les images sont chargées à la demande
   via la fonction serveur admin_get_agency_profile (réservée à l'admin). */
function adminProfileBlock(a){
  const p = adminProfiles[a.accessCode];
  const loading = !p;
  const recto = safeImg(p && p.idRecto);
  const verso = safeImg(p && p.idVerso);
  const slot = src => src
    ? '<div class="id-slot filled"><img src="'+src+'" onclick="openLightbox(this.src)"></div>'
    : '<div class="id-slot" style="cursor:default;">'+(loading ? '…' : ic('creditCard',22))+'</div>';
  const val = v => '<div class="info-value" style="margin-top:2px;">'
    +(v ? esc(v) : '<span style="color:var(--text-3); font-weight:600;">Non renseigné</span>')+'</div>';
  const name = (p && p.agence) || a.agence;
  const place = (p && p.emplacement) || a.emplacement;
  const contact = (p && p.contact) || a.contact;
  return '<div class="section-label">Profil de l\'adhérent</div>'
    +'<div class="admin-row">'
    +'<div class="field"><label>Nom de l\'agence</label>'+val(name)+'</div>'
    +'<div class="field"><label>N° SIRET</label>'+val((p && p.numero) || a.numero)+'</div>'
    +'<div class="field"><label>Carte d\'identité du gérant</label>'
      +'<div class="field-row2" style="margin-top:6px;">'
        +'<div><label style="font-size:11px;">Recto</label>'+slot(recto)+'</div>'
        +'<div><label style="font-size:11px;">Verso</label>'+slot(verso)+'</div>'
      +'</div></div>'
    +'<div class="field"><label>Adresse (agence ou bien loué)</label>'+val(place)+'</div>'
    +'<div class="field" style="margin-bottom:0;"><label>Contact</label>'+val(contact)+'</div>'
    +'</div>';
}

function adminReportRow(r, showDate){
  const meta = effStatus(r);
  return '<div class="admin-row">'
    +'<div class="admin-row-top"><div><div class="mini-name">'+esc(r.prenom)+' '+esc(r.nom)+'</div>'
    +'<div class="mini-sub">'+esc(typeLabel(r.type))+' · '+esc(r.vehicule)+' · '+esc(r.agence)+(showDate && r.createdAt ? ' · '+fmtDate(String(r.createdAt).slice(0,10)) : '')+'</div></div>'
    +'<div class="admin-actions">'
    +'<div class="admin-icbtn" onclick="openEdit(\''+esc(r.id)+'\')">'+ic('edit',16)+'</div>'
    +'<div class="admin-icbtn del" onclick="askDelete(\''+esc(r.id)+'\')">'+ic('trash',16)+'</div>'
    +'</div></div>'
    +'<div class="pill-row"><div class="status-pill '+meta.cls+'">'+meta.label+'</div>'+gravPill(r.gravite)+'</div>'
    +'</div>';
}

async function selectAdminAgency(code){
  adminSelectedAgency = code;
  renderAdminList();
  const l = document.getElementById('admin-list'); if(l) l.scrollTop = 0;
  if(!adminProfiles[code]){
    try{
      const p = await rpc('admin_get_agency_profile', { p_admin_code: adminCode, p_access_code: code });
      adminProfiles[code] = p || {};
    } catch(e){ adminProfiles[code] = {}; dbError(e); }
    if(adminSelectedAgency === code) renderAdminList();
  }
}
function backToAdminAgencies(){
  adminSelectedAgency = null;
  renderAdminList();
}

function renderAdminList(){
  const list = document.getElementById('admin-list');
  if(!list || !adminCode) return;
  const searchEl = document.getElementById('admin-search');

  /* Fiche d'une agence : son profil et tous ses signalements, modifiables */
  const sel = adminSelectedAgency ? adminAgencies.find(x=>x.accessCode === adminSelectedAgency) : null;
  if(sel){
    if(searchEl) searchEl.parentElement.parentElement.style.display = 'none';
    const mine = adminReports.filter(r=>r.authorCode === sel.accessCode);
    list.innerHTML = '<button class="btn secondary" style="margin:6px 0 4px;" onclick="backToAdminAgencies()">← Tous les adhérents</button>'
      + '<div class="section-label" style="margin-top:14px;">Agence</div>'
      + adminAgencyCard(sel, false)
      + '<div class="section-label">Gestion du compte</div>'
      + '<button class="btn secondary" style="margin-bottom:10px;" onclick="askAgencyAction(\'revoke\')">'+(sel.revoked ? 'Rétablir le code d\'accès' : 'Radier le code d\'accès')+'</button>'
      + '<button class="btn danger" onclick="askAgencyAction(\'delete\')">Supprimer le compte</button>'
      + adminExpBlock(sel) + adminProfileBlock(sel)
      + '<div class="section-label">Signalements de l\'agence ('+mine.length+')</div>'
      + (mine.map(r=>adminReportRow(r, true)).join('')
         || '<div class="empty-state"><div class="ic-circle">'+ic('briefcase',26)+'</div><p>Aucun signalement pour cet adhérent</p></div>');
    return;
  }
  adminSelectedAgency = null;
  if(searchEl) searchEl.parentElement.parentElement.style.display = '';

  /* Liste des agences, filtrée par la recherche */
  const q = normStr(searchEl ? searchEl.value : '');
  const filtered = !q ? adminAgencies : adminAgencies.filter(a=>
    normStr([a.agence, a.numero, a.emplacement, a.contact, a.accessCode].join(' ')).includes(q)
  );
  const agencesHtml = filtered.map(a=>adminAgencyCard(a, true)).join('')
    || '<p>'+(q ? 'Aucun adhérent ne correspond à votre recherche.' : 'Aucun adhérent enregistré.')+'</p>';

  const _n = (f)=>adminAgencies.filter(f).length;
  const _recap = 'Mensuel : '+_n(a=>a.plan==='mensuel')+' · Annuel : '+_n(a=>a.plan==='annuel')
    +' · 1 an gratuit : '+_n(a=>a.plan==='gratuit' && !a.expired)+' · Gratuit expiré : '+_n(a=>a.plan==='gratuit' && a.expired);
  let html = '<div class="section-label" style="margin-top:8px;">Adhérents ('+filtered.length+')</div>'
    + '<div class="mini-sub" style="margin:0 2px 10px; font-weight:700;">'+_recap+'</div>' + agencesHtml;
  if(!q){
    html += '<div class="section-label">Signalements ('+adminReports.length+')</div>'
      + (adminReports.map(r=>adminReportRow(r, false)).join('')
         || '<div class="empty-state"><div class="ic-circle">'+ic('briefcase',26)+'</div><p>Aucun signalement enregistré</p></div>');
  }
  list.innerHTML = html;
}
function openEdit(id){
  const r = adminReports.find(x=>x.id===id);
  if(!r) return;
  editingId = id;
  document.getElementById('e-nom').value = r.nom || '';
  document.getElementById('e-prenom').value = r.prenom || '';
  document.getElementById('e-vehicule').value = r.vehicule || '';
  document.getElementById('e-prejudice').value = r.prejudice !== null ? String(r.prejudice) : '';
  document.getElementById('e-description').value = r.description || '';
  document.getElementById('e-statut').value = r.statut;
  document.getElementById('e-type').value = r.type || '';
  document.getElementById('e-gravite').value = String(r.gravite || 0);
  document.getElementById('modal-edit').classList.add('active');
}
async function saveEdit(){
  const nom = document.getElementById('e-nom').value.trim();
  const prenom = document.getElementById('e-prenom').value.trim();
  if(!editingId || !adminCode) return;
  if(!nom || !prenom){ showToast('Le nom et le prénom sont obligatoires.'); return; }
  const pj = parseMoney(document.getElementById('e-prejudice').value);
  if(Number.isNaN(pj)){ showToast('Montant du préjudice invalide.'); return; }
  try{
    const ok = await rpc('admin_update_report', {
      p_admin_code: adminCode, p_id: editingId, p_nom: nom, p_prenom: prenom,
      p_vehicule: document.getElementById('e-vehicule').value.trim(),
      p_description: document.getElementById('e-description').value.trim(),
      p_type: document.getElementById('e-type').value,
      p_gravite: parseInt(document.getElementById('e-gravite').value, 10) || 0,
      p_prejudice: pj,
      p_statut: document.getElementById('e-statut').value
    });
    if(!ok){ showToast('Modification refusée.'); return; }
    closeModal('modal-edit');
    await renderAdmin();
    if(currentAccessCode) loadReports();
  } catch(e){ dbError(e); }
}
function askDelete(id){
  deletingId = id;
  document.getElementById('modal-delete-confirm').classList.add('active');
}
async function confirmDelete(){
  if(!deletingId || !adminCode) return;
  try{
    const ok = await rpc('admin_delete_report', { p_admin_code: adminCode, p_id: deletingId });
    if(!ok){ showToast('Suppression refusée.'); return; }
    closeModal('modal-delete-confirm');
    await renderAdmin();
    if(currentAccessCode) loadReports();
  } catch(e){ dbError(e); }
}

/* =========================================================================
   INITIALISATION DES ICÔNES DE MISE EN PAGE (statiques)
   ========================================================================= */
let avatarMap = {}, myAvatar = null;
function ownAvatar(){ return myAvatar || (currentProfile && currentProfile.ref && avatarMap[currentProfile.ref]) || ''; }
function avatarInner(name, src){ src = safeImg(src); return src ? '<img src="'+src+'" alt="">' : esc(initialsOf(name)); }
function agencyTag(name, ref){
  return '<span class="ag-tag"><span class="ag-av">'+avatarInner(name, ref ? avatarMap[ref] : '')+'</span>'+esc(name)+'</span>';
}
function renderAvatarPick(){
  const el = document.getElementById('profile-avatar-slot');
  if(el) el.innerHTML = avatarInner((currentProfile && currentProfile.agence) || '', ownAvatar());
}
async function loadAvatars(){
  try{
    const l = await rpc('get_agency_avatars', { p_code: currentAccessCode });
    avatarMap = {};
    (l || []).forEach(a=>{ if(a.ref && a.avatar) avatarMap[a.ref] = a.avatar; });
  }catch(e){}
}
async function handleAvatarSelect(evt){
  const file = evt.target.files && evt.target.files[0];
  evt.target.value = '';
  if(!file) return;
  try{
    const img = await compressImage(file, 256, 0.8);
    await rpc('set_agency_avatar', { p_code: currentAccessCode, p_avatar: img });
    myAvatar = img;
    if(currentProfile && currentProfile.ref) avatarMap[currentProfile.ref] = img;
    renderAvatarPick(); renderHome();
    showToast('Photo de profil enregistrée');
  }catch(e){ dbError(e); }
}

function initStaticIcons(){
  document.querySelector('.ghost-admin').innerHTML = ic('lock',18);
  document.getElementById('fab-home').innerHTML = ic('home',20);
  document.querySelectorAll('#view-access .icon-btn')[0].innerHTML = ic('chevronLeft',20);
  document.querySelector('#view-access .icon-hero').innerHTML = ic('key',28);
  document.querySelector('#view-code .icon-hero').innerHTML = ic('key',28);
  document.querySelector('#view-profile .icon-btn').innerHTML = ic('chevronLeft',20);
  document.getElementById('agency-edit-ic').innerHTML = ic('edit',16);
  ['report','profile'].forEach(ctx=>{ renderIdSlot(ctx,'recto'); renderIdSlot(ctx,'verso'); });
  updateStripeButtonLabel();
  document.querySelector('#view-subscription .icon-btn').innerHTML = ic('chevronLeft',20);
  document.querySelectorAll('#view-subscription .ic-wrap')[0].innerHTML = ic('flag',18);
  document.querySelectorAll('#view-subscription .ic-wrap')[1].innerHTML = ic('search',18);
  document.querySelectorAll('#view-subscription .ic-wrap')[2].innerHTML = ic('shield',18);
  document.querySelectorAll('.tab')[0].innerHTML = ic('home',20)+'<span>Accueil</span><div class="dot"></div>';
  document.querySelectorAll('.tab')[1].innerHTML = ic('flag',20)+'<span>Signaler</span><div class="dot"></div>';
  document.querySelectorAll('.tab')[2].innerHTML = ic('search',20)+'<span>Rechercher</span><div class="dot"></div>';
  document.querySelectorAll('.grid-actions .ic-wrap')[0].innerHTML = ic('flag',20);
  document.querySelectorAll('.grid-actions .ic-wrap')[1].innerHTML = ic('search',20);
  document.querySelector('#view-detail .icon-btn').innerHTML = ic('chevronLeft',20);
  document.querySelector('#view-admin .icon-btn').innerHTML = ic('chevronLeft',20);
  document.querySelector('#modal-confirm .modal-icon').innerHTML = ic('checkCircle',24);
  document.querySelector('#modal-reminder .modal-icon').innerHTML = ic('clock',24);
  document.querySelector('#modal-regularise .modal-icon').innerHTML = ic('checkCircle',24);
  document.querySelector('#view-linked .icon-btn').innerHTML = ic('chevronLeft',20);
  document.querySelector('#modal-admin-login .modal-icon').innerHTML = ic('lock',24);
  document.querySelector('#modal-delete-confirm .modal-icon').innerHTML = ic('trash',24);
  document.getElementById('lightbox-close').innerHTML = ic('x',18);
  document.querySelector('#modal-agency-action .modal-icon').innerHTML = ic('alertTriangle',24);
  document.querySelector('#view-verify .icon-btn').innerHTML = ic('chevronLeft',20);
  renderIdSlot('verify','recto'); renderIdSlot('verify','verso');
  renderPhotoGrid();
}

/* =========================================================================
   COMPTES PRO / PARTICULIER, ANTI-FRAUDE, RAPPELS DE FIN D'ANNÉE GRATUITE
   ========================================================================= */
let acctType = 'pro';
function selectType(t){
  acctType = t;
  document.querySelectorAll('.plan[data-type]').forEach(p=>p.classList.toggle('selected', p.getAttribute('data-type') === t));
  applyTypeUi();
}
function applyTypeUi(){
  const pro = acctType === 'pro', g = id=>document.getElementById(id);
  g('v-siret-wrap').style.display = pro ? '' : 'none';
  g('v-addr-wrap').style.display = pro ? 'none' : '';
  g('v-id-label').textContent = pro ? "Carte d'identité du gérant" : "Votre pièce d'identité";
  g('v-intro').textContent = pro
    ? "Pour protéger le réseau, envoyez la carte d'identité du gérant, ses informations et le n° SIRET de la structure avant de payer."
    : "Pour protéger le réseau et éviter les comptes multiples, envoyez votre pièce d'identité, vos informations et l'adresse du bien que vous louez avant de payer.";
  g('type-wrap').style.display = renewCode ? 'none' : '';
}
function luhn(s){ let t=0; for(let i=0;i<s.length;i++){ let d=+s[s.length-1-i]; if(i%2){ d*=2; if(d>9) d-=9; } t+=d; } return t%10===0; }
const siretOk = s => /^\d{14}$/.test(s) && (luhn(s) || s.indexOf('356000000') === 0);
const gv = id => (document.getElementById(id) || {}).value || '';
function readVerify(){
  return { type:acctType, siret:gv('v-siret').replace(/\D/g,''), nom:gv('v-nom').trim(), prenom:gv('v-prenom').trim(), naissance:gv('v-naiss'), idn:gv('v-idn').trim(), addr:gv('v-addr').trim() };
}
/* ---- Rappels : 1 mois, 2 semaines, 1 semaine, 3 jours et la veille de la fin de l'année gratuite ---- */
const REMINDERS = [1,3,7,14,30];
function daysLeft(p){ return Math.round((Date.parse(p.paidUntil) - Date.parse(today10())) / 864e5); }
function maybeRemind(p){
  if(!p || p.plan !== 'gratuit' || p.expired || !p.paidUntil) return;
  const d = daysLeft(p), m = REMINDERS.find(x=>d <= x);
  if(!m || (p.remindSeen && p.remindSeen <= m)) return;
  const when = d <= 0 ? "aujourd'hui" : (d === 1 ? 'demain' : 'dans '+d+' jours'), end = new Date(p.paidUntil).toLocaleDateString('fr-FR');
  document.getElementById('rem-title').textContent = d <= 0 ? "Dernier jour d'accès gratuit" : (d === 1 ? 'Dernier rappel : votre accès se termine demain' : 'Votre année gratuite se termine bientôt');
  document.getElementById('rem-text').textContent = "Votre année gratuite se termine "+when+" (le "+end+"). Vous devrez alors renouveler votre abonnement pour continuer à utiliser Immo'Track. Vous gardez le même code d'accès et le même compte.";
  window._remM = m;
  document.getElementById('modal-reminder').classList.add('active');
}
async function remindMark(){
  const m = window._remM; closeModal('modal-reminder');
  if(currentProfile) currentProfile.remindSeen = m;
  try{ await rpc('set_reminder_seen', { p_code: currentAccessCode, p_m: m }); }catch(e){}
}
async function remindSubscribe(){ await remindMark(); renewCode = currentAccessCode; goTo('subscription'); }
function remindLater(){ remindMark(); }
function adminExpBlock(a){
  if(a.plan !== 'gratuit') return '';
  return '<div class="section-label">Test des rappels (année gratuite)</div><div class="admin-row"><div class="field" style="margin-bottom:8px;"><label>Date de fin de l\'année gratuite</label><input type="date" id="adm-exp" value="'+esc(String(a.paidUntil || '').slice(0,10))+'"></div><button class="btn secondary" onclick="adminSetExp()">Appliquer la date</button><div class="hint">Choisissez une date dans moins de 30 jours : le rappel s\'affichera à la prochaine connexion de l\'adhérent.</div></div>';
}
async function adminSetExp(){
  const v = document.getElementById('adm-exp').value;
  if(!v || !adminSelectedAgency) return;
  try{ await rpc('admin_set_exp', { p_admin_code: adminCode, p_access_code: adminSelectedAgency, p_date: v }); await renderAdmin(); showToast('Date de fin mise à jour'); }catch(e){ dbError(e); }
}

let legalBack = 'landing';
function openLegal(name){ if(currentView !== 'privacy' && currentView !== 'legal') legalBack = currentView; goTo(name); }
function closeLegal(){ goTo(legalBack || 'landing'); }
['privacy','legal'].forEach(n=>{ const b = document.querySelector('#view-'+n+' .icon-btn'); if(b) b.innerHTML = ic('chevronLeft',20); });
document.querySelector('#modal-rgpd-warn .modal-icon').innerHTML = ic('alertTriangle',24);

initStaticIcons();
initIncidentUi();
runSearch();
handleStripeReturn().then(handled=>{ if(!handled) restoreSession(); });
</script>
</body>
</html>
